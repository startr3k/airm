# Copy to backend/.env and fill in. Never commit the real file: backend/.env is
# gitignored, and the backend refuses to start without a key rather than failing on
# the first user's request.
ANTHROPIC_API_KEY=sk-ant-...

# The model that answers an assessment request. Sonnet 5 is the default because the
# eval harness measures it as more accurate on the tier than Opus 5 here, at a third
# of the cost and a third faster -- see docs/EVALS.md.
ASSESS_MODEL=claude-sonnet-5

# The model that reads the handbook PDF during offline ingestion. Ingestion runs once,
# has to be right, and is not latency-sensitive, so it uses the stronger model.
INGEST_MODEL=claude-opus-5

# Reasoning depth (output_config.effort): low | medium | high | xhigh | max.
ASSESS_EFFORT=medium
INGEST_EFFORT=high

# The handbook, relative to the repository root. Only needed for `make ingest` and to
# render a cited page in the source sheet; every citation itself comes from the
# committed framework pack.
HANDBOOK_PDF=docs/MindForge AI Risk Management Operationalisation Handbook.pdf

# Where assessment history is stored. Defaults to backend/assessments.sqlite3.
# MINDFORGE_DB=/data/assessments.sqlite3

# Where the built front end is served from when the API serves it (the Docker image
# sets this). Leave unset in development: Vite serves the front end instead.
# STATIC_DIR=/app/static
